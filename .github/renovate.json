{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    {
      "description": "Require manual review for Python compatibility range changes",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "automerge": false
    }
  ],
  "platformAutomerge": false,
  "ignoreTests": false,
  "minimumReleaseAge": "1 day",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automatically merge minor and patch-level updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
